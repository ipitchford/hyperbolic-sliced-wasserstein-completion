{"data":{"id":"10.5281/zenodo.23295188","type":"dois","attributes":{"doi":"10.5281/zenodo.23295188","prefix":"10.5281","suffix":"zenodo.23295188","identifiers":[{"identifier":"oai:zenodo.org:23295188","identifierType":"oai"}],"alternateIdentifiers":[{"alternateIdentifierType":"oai","alternateIdentifier":"oai:zenodo.org:23295188"}],"creators":[{"name":"Anonymous","nameType":"Personal","familyName":"Anonymous","nameIdentifiers":[],"affiliation":[]}],"titles":[{"title":"Sliced Wasserstein distance at the critical moment: the noninteger case"}],"publisher":"Zenodo","container":{},"publicationYear":2026,"subjects":[{"subject":"sliced Wasserstein distance"},{"subject":"Wasserstein distance"},{"subject":"optimal transport"},{"subject":"critical moment"},{"subject":"cosine transform"},{"subject":"Mellin transform"},{"subject":"unrefereed candidate"}],"contributors":[],"dates":[{"date":"2026-10-11","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsSupplementTo","relatedIdentifier":"https://github.com/ipitchford/noninteger-sliced-wasserstein","relatedIdentifierType":"URL"},{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.23295187","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1.1.0-candidate","rightsList":[{"rights":"Creative Commons Zero v1.0 Universal","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc0-1.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Unrefereed candidate mathematical research release. For every dimension d \u003e= 2 and every fixed noninteger p \u003e 1, the manuscript claims a uniform comparison on the full p-moment ball, with W_p bounded by C_{d,p} times the sliced p-Wasserstein distance to the exponent 1/[p(p+d+2)]. The analytic proof uses weighted moment measures on a logarithmic-radius cylinder, one-sided cosine-transform multipliers, finite angular smoothing, and compact-frequency inversion. The package includes source, proof text, bibliography, and finite diagnostics. Those diagnostics check selected identities and deliberately corrupted controls; they do not formally verify the universal theorem. The result is not externally peer reviewed or independently reproduced. Original research content is CC0-1.0 and original code is MIT; the record-level CC0 licence applies to original research content only.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://zenodo.org/doi/10.5281/zenodo.23295188","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-10-11T08:58:39.000Z","registered":"2026-10-11T08:58:39.000Z","published":"2026","updated":"2026-10-11T08:58:39.000Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}},"provider":{"data":{"id":"cern","type":"providers"}},"media":{"data":{"id":"10.5281/zenodo.23295188","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.5281/zenodo.23295187","type":"dois"}]}}}}